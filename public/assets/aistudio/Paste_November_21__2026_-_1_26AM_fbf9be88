        "vlc": "vlc --demux=h264 --network-caching=0 tcp://<host>:<videoPort>",
        "openCvPython": "cv2.VideoCapture('tcp://<host>:<videoPort>', cv2.CAP_FFMPEG)"
      }
    },
    "HEVC_TCP": {
      "enumName": "HEVC_TCP",
      "defaultProtocol": false,
      "availability": "Condicional: solo si MediaCodecList reporta encoder hardware video/hevc",
      "transport": "Raw TCP socket",
      "urlFormat": "tcp://<host>:<videoPort>",
      "mimeType": "video/hevc",
      "wireFormat": "Raw H.265/HEVC Annex-B byte stream (VPS/SPS/PPS en CODEC_CONFIG + frames IDR/P sin contenedor)",
      "syncAndLateJoinBehavior": "Identico a H264_TCP (reenvia CODEC_CONFIG cacheado + solicita IDR inmediato + Channel capacidad 3 DROP_OLDEST).",
      "pcRecommendedCommands": {

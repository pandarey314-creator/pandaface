        "ffmpegRawPipe": "ffmpeg -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0 -f hevc -i tcp://<host>:<videoPort> -f rawvideo -pix_fmt bgr24 pipe:1",
        "vlc": "vlc --demux=hevc --network-caching=0 tcp://<host>:<videoPort>"
      }
    },
    "MJPEG_HTTP": {
      "enumName": "MJPEG_HTTP",
      "defaultProtocol": false,
      "transport": "HTTP/1.1 sobre TCP",
      "urlFormat": "http://<host>:<videoPort>/video",
      "endpoints": {
        "/video": {
          "description": "Stream multipart JPEG continuo",
          "httpResponseHeaders": {
            "HTTP": "HTTP/1.1 200 OK",
            "Content-Type": "multipart/x-mixed-replace; boundary=camlinkframe",
            "Cache-Control": "no-store, no-cache, must-revalidate, pre-check=0, post-check=0, max-age=0",
            "Pragma": "no-cache",
            "Expires": "-1",
            "Access-Control-Allow-Origin": "*",
            "Connection": "close"
          },
          "partFormat": "--camlinkframe\\r\\nContent-Type: image/jpeg\\r\\nContent-Length: <byte_length>\\r\\n\\r\\n<raw_jpeg_bytes>\\r\\n",
          "bufferPolicy": "Channel(capacity=1, onBufferOverflow=DROP_OLDEST) para entregar siempre el frame mas reciente.",
          "encodingPipeline": "Camera2 ImageFormat.YUV_420_888 (maxImages=2) -> NV21 -> YuvImage.compressToJpeg(jpegQuality)"

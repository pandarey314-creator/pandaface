        "/monitor": {
          "description": "Pagina HTML5 embebida con <img src='/video'> y auto-reconexion JS cada 600 ms.",
          "contentType": "text/html; charset=utf-8"
        }
      },
      "pcRecommendedCommands": {
        "ffplay": "ffplay -fflags nobuffer -flags low_delay -framedrop -f mpjpeg http://<host>:<videoPort>/video",
        "vlc": "vlc --network-caching=0 http://<host>:<videoPort>/video",
        "openCvPython": "cv2.VideoCapture('http://<host>:<videoPort>/video')"
      }
    }
